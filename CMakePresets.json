{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "a100-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_ARCHITECTURES": "80-real",
        "CUFHE_GPU_BACKEND": "CUDA",
        "ENABLE_TEST": "ON",
        "USE_BLOCK_BINARY": "ON",
        "USE_CUDA_MIN_BLOCKS": "ON",
        "CUFHE_CUDA_NTT_MIN_BLOCKS_SM80": "1",
        "CUFHE_CUDA_FFT_MIN_BLOCKS_SM80": "1",
        "USE_CUDA_COOPERATIVE_SCALAR": "OFF"
      }
    },
    {
      "name": "a100-ntt",
      "displayName": "A100 block-binary NTT (lvl1 throughput / lvl02 latency)",
      "inherits": "a100-base",
      "binaryDir": "${sourceDir}/build-a100-ntt-optimized",
      "cacheVariables": {
        "USE_FFT": "OFF",
        "USE_CUDA_WARP_TRANSFORM64": "ON",
        "USE_CUDA_PAIRED_NTT": "ON",
        "USE_CUDA_PAIRED_NTT_WARP": "ON",
        "USE_CUDA_PAIRED_NTT_MADD4": "ON",
        "USE_CUDA_ASYNC_MONOMIALS": "ON",
        "USE_CUDA_WARP_MODSWITCH_CORRECTION": "ON",
        "USE_CUDA_WORD32_REDUCTION": "ON",
        "USE_CUDA_UNREDUCED_INVERSE_DIFF": "ON",
        "USE_CUDA_PACKED_PAIRED_ROOTS": "ON"
      }
    },
    {
      "name": "a100-ntt-latency",
      "displayName": "A100 block-binary NTT (cooperative lvl02 scalar NAND)",
      "inherits": "a100-ntt",
      "binaryDir": "${sourceDir}/build-a100-ntt-latency",
      "cacheVariables": {
        "USE_CUDA_COOPERATIVE_SCALAR": "ON"
      }
    },
    {
      "name": "a100-ntt-throughput",
      "displayName": "A100 block-binary NTT (two resident lvl1 gate blocks)",
      "inherits": "a100-ntt",
      "binaryDir": "${sourceDir}/build-a100-ntt-throughput",
      "cacheVariables": {
        "CUFHE_CUDA_NTT_MIN_BLOCKS_SM80": "2"
      }
    },
    {
      "name": "a100-fft",
      "displayName": "A100 block-binary FFT (large lvl02 batches)",
      "inherits": "a100-base",
      "binaryDir": "${sourceDir}/build-a100-fft-optimized",
      "cacheVariables": {
        "USE_FFT": "ON",
        "USE_GPU_FFT": "ON"
      }
    },
    {
      "name": "a100-fft-throughput",
      "displayName": "A100 block-binary FFT (two resident lvl02 gate blocks)",
      "inherits": "a100-fft",
      "binaryDir": "${sourceDir}/build-a100-fft-throughput",
      "cacheVariables": {
        "CUFHE_CUDA_FFT_MIN_BLOCKS_SM80": "2"
      }
    },
    {
      "name": "r9700-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUFHE_GPU_BACKEND": "HIP",
        "CMAKE_HIP_ARCHITECTURES": "gfx1201",
        "ENABLE_TEST": "ON",
        "USE_BLOCK_BINARY": "ON",
        "USE_KEY_BUNDLE": "OFF",
        "USE_SUBSET_KEY": "ON",
        "CUFHE_HIP_MIN_WAVES_PER_EU": "1",
        "USE_HIP_PAIRED_NTT": "OFF",
        "USE_HIP_PAIRED_NTT64": "OFF",
        "USE_HIP_FUSED_NTT": "OFF",
        "USE_HIP_MONOMIAL_STAGING": "OFF",
        "USE_HIP_PREPARED_KEYSWITCH": "OFF",
        "USE_HIP_NATIVE_KEYSWITCH": "OFF",
        "USE_HIP_WAVE_MODSWITCH_CORRECTION": "OFF",
        "USE_HIP_LOW_LDS": "OFF",
        "USE_HIP_COOPERATIVE_BATCH": "OFF",
        "USE_HIP_COOPERATIVE_SCALAR": "OFF",
        "USE_CUDA_ASYNC_MONOMIALS": "OFF",
        "USE_CUDA_WORD32_REDUCTION": "OFF",
        "USE_CUDA_PAIRED_NTT_MADD4": "OFF",
        "USE_CUDA_SHOUP_NTT": "ON",
        "USE_CUDA_PAIRED_NTT": "ON",
        "USE_CUDA_PAIRED_NTT_WARP": "OFF",
        "USE_CUDA_WARP_TRANSFORM64": "OFF",
        "USE_CUDA_UNREDUCED_INVERSE_DIFF": "OFF",
        "USE_CUDA_PACKED_PAIRED_ROOTS": "OFF",
        "CUFHE_HIP_COOPERATIVE_GROUPS": "0"
      }
    },
    {
      "name": "r9700-ntt-baseline",
      "inherits": "r9700-base",
      "binaryDir": "${sourceDir}/build-r9700-ntt-baseline",
      "cacheVariables": {
        "USE_FFT": "OFF"
      }
    },
    {
      "name": "r9700-fft-baseline",
      "inherits": "r9700-base",
      "binaryDir": "${sourceDir}/build-r9700-fft-baseline",
      "cacheVariables": {
        "USE_FFT": "ON",
        "USE_GPU_FFT": "ON"
      }
    },
    {
      "name": "r9700-ntt",
      "inherits": "r9700-ntt-baseline",
      "binaryDir": "${sourceDir}/build-r9700-ntt",
      "cacheVariables": {
        "USE_HIP_PAIRED_NTT": "ON",
        "USE_HIP_PAIRED_NTT64": "ON",
        "USE_HIP_FUSED_NTT": "ON",
        "USE_HIP_LOW_LDS": "ON",
        "USE_HIP_PREPARED_KEYSWITCH": "ON",
        "USE_HIP_WAVE_MODSWITCH_CORRECTION": "ON",
        "USE_HIP_COOPERATIVE_BATCH": "ON"
      }
    },
    {
      "name": "r9700-ntt-throughput",
      "inherits": "r9700-ntt",
      "binaryDir": "${sourceDir}/build-r9700-ntt-throughput",
      "cacheVariables": {
        "USE_HIP_PAIRED_NTT64": "OFF"
      }
    },
    {
      "name": "r9700-ntt-latency",
      "inherits": "r9700-ntt",
      "binaryDir": "${sourceDir}/build-r9700-ntt-latency",
      "cacheVariables": {
        "USE_HIP_COOPERATIVE_SCALAR": "ON"
      }
    },
    {
      "name": "r9700-fft",
      "inherits": "r9700-fft-baseline",
      "binaryDir": "${sourceDir}/build-r9700-fft",
      "cacheVariables": {}
    }
  ]
}
